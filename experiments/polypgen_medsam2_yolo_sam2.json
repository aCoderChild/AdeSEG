{
  "name": "polypgen_medsam2_yolo_sam2",
  "data_root": "data/polypgen",
  "bbox_root": "data/bbox",
  "output_root": "outputs",
  "sequences": {
    "start": 1,
    "end": 23
  },
  "method_defaults": {
    "all": {
      "bbox_root": "data/bbox",
      "yolo_checkpoint": "checkpoints/polypgen_yolov8n.pt",
      "yolo_conf": 0.5,
      "yolo_imgsz": 640,
      "max_yolo_boxes_per_frame": 1
    },
    "YOLO_SAM2": {
      "script": "external/YOLO_SAM2/Test.py",
      "sam2_cfg": "configs/sam2.1_hiera_t512.yaml",
      "sam2_checkpoint": "checkpoints/MedSAM2_latest.pt"
    },
    "MedSAM2": {
      "script": "external/MedSAM2/medsam2_infer_video_with_yolo.py",
      "sam2_cfg": "configs/sam2.1_hiera_t512.yaml",
      "sam2_checkpoint": "checkpoints/MedSAM2_latest.pt",
      "video_prompt_limit": 0
    },
    "MedSAM3": {
      "script": "external/MedSAM3/medsam3_infer_polypgen.py",
      "output_root": "outputs_MedSAM3",
      "config": "external/MedSAM3/configs/full_lora_config.yaml",
      "weights": "checkpoints/MedSAM3_v1/best_lora_weights.pt",
      "base_checkpoint": "checkpoints/facebook_sam3/sam3.pt",
      "prompt": ["polyp"],
      "threshold": 0.5,
      "nms_iou": 0.5,
      "resolution": 1008,
      "max_detections_per_frame": 1
    }
  },
  "methods": {
    "MedSAM3_TEXT_POLYP": {
      "enabled": false,
      "runner": "MedSAM3",
      "output_name": "MedSAM3_TEXT_POLYP",
      "eval_type": "mask"
    },

    "YOLO_SAM2_YOLO_BOX_FRAME": {
      "enabled": true,
      "runner": "YOLO_SAM2",
      "output_name": "YOLO_SAM2_YOLO_BOX_FRAME",
      "prompt_source": "yolo"
    },
    "YOLO_SAM2_GT_BOX_FRAME": {
      "enabled": true,
      "runner": "YOLO_SAM2",
      "output_name": "YOLO_SAM2_GT_BOX_FRAME",
      "prompt_source": "gt_bbox",
      "eval_type": "mask"
    },

    "MedSAM2_GT_BOX_BOX": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_BOX",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "box",
      "video_prompt_stride": 1,
      "eval_type": "mask"
    },
    "MedSAM2_GT_BOX_MASK": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_MASK",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "mask",
      "video_prompt_stride": 1,
      "eval_type": "mask"
    },
    "MedSAM2_YOLO_BOX_BOX": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_BOX",
      "prompt_source": "yolo",
      "video_prompt_source": "box",
      "video_prompt_stride": 1
    },
    "MedSAM2_YOLO_BOX_MASK": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_MASK",
      "prompt_source": "yolo",
      "video_prompt_source": "mask",
      "video_prompt_stride": 1
    },

    "MedSAM2_GT_BOX_BOX_STRIDE5": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_BOX_STRIDE5",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "box",
      "video_prompt_stride": 5,
      "eval_type": "mask"
    },
    "MedSAM2_GT_BOX_MASK_STRIDE5": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_MASK_STRIDE5",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "mask",
      "video_prompt_stride": 5,
      "eval_type": "mask"
    },
    "MedSAM2_YOLO_BOX_BOX_STRIDE5": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_BOX_STRIDE5",
      "prompt_source": "yolo",
      "video_prompt_source": "box",
      "video_prompt_stride": 5
    },
    "MedSAM2_YOLO_BOX_MASK_STRIDE5": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_MASK_STRIDE5",
      "prompt_source": "yolo",
      "video_prompt_source": "mask",
      "video_prompt_stride": 5
    },

    "MedSAM2_GT_BOX_BOX_STRIDE10": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_BOX_STRIDE10",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "box",
      "video_prompt_stride": 10,
      "eval_type": "mask"
    },
    "MedSAM2_GT_BOX_MASK_STRIDE10": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_MASK_STRIDE10",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "mask",
      "video_prompt_stride": 10,
      "eval_type": "mask"
    },
    "MedSAM2_YOLO_BOX_BOX_STRIDE10": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_BOX_STRIDE10",
      "prompt_source": "yolo",
      "video_prompt_source": "box",
      "video_prompt_stride": 10
    },
    "MedSAM2_YOLO_BOX_MASK_STRIDE10": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_MASK_STRIDE10",
      "prompt_source": "yolo",
      "video_prompt_source": "mask",
      "video_prompt_stride": 10
    },

    "MedSAM2_GT_BOX_BOX_FIRST": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_BOX_FIRST",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "box",
      "video_prompt_stride": 1,
      "video_prompt_limit": 1,
      "eval_type": "mask"
    },
    "MedSAM2_GT_BOX_MASK_FIRST": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_GT_BOX_MASK_FIRST",
      "prompt_source": "gt_bbox",
      "video_prompt_source": "mask",
      "video_prompt_stride": 1,
      "video_prompt_limit": 1,
      "eval_type": "mask"
    },
    "MedSAM2_YOLO_BOX_BOX_FIRST": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_BOX_FIRST",
      "prompt_source": "yolo",
      "video_prompt_source": "box",
      "video_prompt_stride": 1,
      "video_prompt_limit": 1
    },
    "MedSAM2_YOLO_BOX_MASK_FIRST": {
      "enabled": true,
      "runner": "MedSAM2",
      "output_name": "MedSAM2_YOLO_BOX_MASK_FIRST",
      "prompt_source": "yolo",
      "video_prompt_source": "mask",
      "video_prompt_stride": 1,
      "video_prompt_limit": 1
    },

    "SAM2_LARGE_GT_BOX_FRAME": {
      "enabled": true,
      "runner": "YOLO_SAM2",
      "output_name": "SAM2_LARGE_GT_BOX_FRAME",
      "prompt_source": "gt_bbox",
      "eval_type": "mask",
      "sam2_cfg": "configs/sam2_hiera_l.yaml",
      "sam2_checkpoint": "checkpoints/sam2_hiera_large.pt"
    }
  }
}
